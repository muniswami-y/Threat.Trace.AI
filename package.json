{
  "name": "threattrace-ai-root",
  "version": "1.0.0",
  "private": true,
  "description": "ThreatTrace AI - Root Workspace",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd ThreatTraceAI/backend && python -m uvicorn app.main:app --reload --port 8000 --host 127.0.0.1",
    "dev:frontend": "cd ThreatTraceAI/frontend && npm run dev",
    "build": "cd ThreatTraceAI/frontend && npm run build",
    "start": "cd ThreatTraceAI/backend && python -m uvicorn app.main:app --port 8000 --host 127.0.0.1"
  },
  "dependencies": {
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
